{
  "name": "Discussion Question posted",
  "description": "N5. A Student posted a Discussion Question on a lesson. Goes to the course's Instructor.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "New Discussion Question on {{ data.lessonTitle }} — {{ data.courseTitle }}",
        "settings": {
          "layout_key": "default",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "knock-email"
    }
  ],
  "categories": [
    "discussions"
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "discussion-question-posted",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
