{
  "name": "Discussion Reply posted",
  "description": "N6. Someone posted a Discussion Reply. Goes to the Discussion Question's author; says \"answered\" when the reply is from the course's Instructor or a Platform Admin.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "{% if data.answered %}Your Question was answered{% else %}New reply to your comment{% endif %} — {{ data.lessonTitle }}",
        "settings": {
          "layout_key": "default",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "knock-email"
    }
  ],
  "categories": [
    "discussions"
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "discussion-reply-posted",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
